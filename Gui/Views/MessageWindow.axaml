<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PtzJoystickControl.Gui.Views.MessageWindow"
        Width="560" Height="340" MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="Message">

	<Grid RowDefinitions="*,Auto" Margin="12">
		<TextBox x:Name="MessageBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
		         FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
			<Button Content="Copy" Click="OnCopyClicked"/>
			<Button Content="Close" Click="OnCloseClicked" MinWidth="80" HorizontalContentAlignment="Center"/>
		</StackPanel>
	</Grid>
</Window>
