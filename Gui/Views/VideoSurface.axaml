<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:vm="using:PtzJoystickControl.Gui.ViewModels"
             x:Class="PtzJoystickControl.Gui.Views.VideoSurface"
             x:DataType="vm:VideoViewModel">
	<Grid Background="Black">
		<vlc:VideoView MediaPlayer="{Binding MediaPlayer}" IsVisible="{Binding UsesVlc}"/>
		<Image x:Name="NdiImage" Source="{Binding Frame}" Stretch="Uniform" IsVisible="{Binding UsesNdi}"/>
	</Grid>
</UserControl>
