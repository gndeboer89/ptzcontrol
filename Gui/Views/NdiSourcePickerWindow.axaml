<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PtzJoystickControl.Gui.ViewModels"
        x:Class="PtzJoystickControl.Gui.Views.NdiSourcePickerWindow"
        x:DataType="vm:NdiSourcePickerViewModel"
        Width="480" Height="360" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="Choose an NDI source">

	<Grid RowDefinitions="Auto,*,Auto" Margin="10">
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
			<Button Content="Scan again" Command="{Binding ScanCommand}"/>
			<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" Width="120" VerticalAlignment="Center"/>
		</StackPanel>

		<ListBox Grid.Row="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding Selected}" Background="#2000"
		         DoubleTapped="OnDoubleTapped"/>

		<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
			<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
				<TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
				<TextBlock Text="NDI® is a registered trademark of Vizrt Group." FontSize="10" Opacity="0.5"/>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button Content="Use" Click="OnUseClicked" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
				<Button Content="Cancel" Click="OnCancelClicked"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
