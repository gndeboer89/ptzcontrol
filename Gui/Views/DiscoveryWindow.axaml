<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PtzJoystickControl.Gui.ViewModels"
        x:Class="PtzJoystickControl.Gui.Views.DiscoveryWindow"
        x:DataType="vm:DiscoveryViewModel"
        Width="600" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="Find cameras">

	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
			<Button Content="Scan" Command="{Binding ScanCommand}" Width="90" HorizontalContentAlignment="Center"/>
			<Button Content="Stop" Click="OnStopClicked" IsVisible="{Binding IsScanning}" Width="90" HorizontalContentAlignment="Center"/>
			<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" Width="120" VerticalAlignment="Center"/>
		</StackPanel>

		<ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="#2000">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:DiscoveredCameraItem">
					<Grid ColumnDefinitions="Auto,*" Margin="2">
						<CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center"/>
						<StackPanel Grid.Column="1" Margin="5,0">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding Address}" Opacity="0.7"/>
							</StackPanel>
							<TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
			<TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button Content="Add selected" Command="{Binding AddSelectedCommand}"/>
				<Button Content="Close" Click="OnCloseClicked"/>
			</StackPanel>
		</Grid>

		<Expander Grid.Row="3" Header="Camera not found? Check an address" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
			<StackPanel Spacing="6" Margin="0,6,0,0">
				<TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
				           Text="Enter the camera's IP address (you can see it in the camera's web page or an NDI tool). The report shows which protocols and ports it answers on."/>
				<Grid ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0" Text="{Binding CheckAddress}" Watermark="192.168.1.50" Margin="0,0,8,0"/>
					<Button Grid.Column="1" Content="Check address" Command="{Binding CheckCommand}"/>
				</Grid>
				<TextBox Text="{Binding Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
				         Height="170" FontFamily="Consolas,Menlo,monospace" FontSize="11"/>
			</StackPanel>
		</Expander>
	</Grid>
</Window>
