<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:PtzJoystickControl.Gui.Views"
        xmlns:vm="using:PtzJoystickControl.Gui.ViewModels"
        x:Class="PtzJoystickControl.Gui.Views.MultiviewWindow"
        x:DataType="vm:MultiviewViewModel"
        Width="1180" Height="700" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="Multiview">

	<Grid RowDefinitions="Auto,*" Background="#101010">
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,6">
			<StackPanel Grid.Column="0" VerticalAlignment="Center">
				<TextBlock Text="{Binding ActiveDescription}" FontWeight="SemiBold" Foreground="#7CFFB0" TextTrimming="CharacterEllipsis"/>
				<TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Opacity="0.75"/>
			</StackPanel>
			<CheckBox Grid.Column="1" Content="Active camera large" IsChecked="{Binding FocusLayout}" IsVisible="{Binding HasTiles}" Margin="10,0,10,0"/>
			<TextBlock Grid.Column="2" Text="Columns" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding IsGridMode}"/>
			<ComboBox Grid.Column="3" ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding ColumnChoice}" IsVisible="{Binding IsGridMode}" MinWidth="80">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="x:Int32">
						<TextBlock Text="{Binding, Converter={x:Static v:ColumnChoiceConverter.Instance}}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<!-- Equal grid: all pictures the same size (also used when no camera is selected). -->
		<ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" IsVisible="{Binding IsGridMode}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="{Binding Columns}"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:VideoViewModel">
					<v:MultiviewTile/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Focus: the camera under joystick control large, the others small next to it. -->
		<Grid Grid.Row="1" ColumnDefinitions="*,300" IsVisible="{Binding IsFocusMode}">
			<ContentControl Grid.Column="0" Content="{Binding ActiveTile}">
				<ContentControl.ContentTemplate>
					<DataTemplate x:DataType="vm:VideoViewModel">
						<v:MultiviewTile/>
					</DataTemplate>
				</ContentControl.ContentTemplate>
			</ContentControl>
			<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding OtherTiles}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:VideoViewModel">
							<v:MultiviewTile Height="190"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>
